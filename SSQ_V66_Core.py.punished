import pandas as pd
import numpy as np
import os
import json
from datetime import datetime

# ==========================================
# ⚙️ 核心环境路径 (E:/享中 武器库)
# ==========================================
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
CSV_FILE = os.path.join(BASE_DIR, "ssq_history_full.csv")
MEMORY_FILE = os.path.join(BASE_DIR, "Master_Memory.json")
LATEST_MD = os.path.join(BASE_DIR, "Latest_Prediction.md")

class ZhenSuanTianJiArbitrator:
    def __init__(self):
        self.version = "V66.1-Causal-Boost"
        print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
        print(f"🚀 {self.version} 仲裁系统启动...")
        self.memory = self._load_memory_safe()

    def _load_memory_safe(self):
        """目标 1：修复 JSONDecodeError (解决截图 202537 的崩溃)"""
        default_mem = {"version": self.version, "iterations": 0, "history": []}
        if not os.path.exists(MEMORY_FILE):
            return default_mem
        try:
            with open(MEMORY_FILE, 'r', encoding='utf-8') as f:
                content = f.read().strip()
                return json.loads(content) if content else default_mem
        except Exception:
            return default_mem

    def _calculate_weights(self, df):
        """目标 2：全量精准重写 (解决 195313 数据冲突)"""
        df_numeric = df.apply(pd.to_numeric, errors='coerce')
        raw_vals = df_numeric.values.flatten()
        valid_nums = raw_vals[~np.isnan(raw_vals)]
        
        # 红球权重：频率 * 1.5 + 遗漏 * 0.1
        red_pool = valid_nums[(valid_nums >= 1) & (valid_nums <= 33)]
        counts = pd.Series(red_pool).value_counts()
        weights = {n: (counts.get(n, 0) * 1.5) + (10 if n not in red_pool else 0) for n in range(1, 34)}
        
        sorted_nodes = sorted(weights.items(), key=lambda x: x[1], reverse=True)
        red_pred = sorted([int(x[0]) for x in sorted_nodes[:6]])
        
        # 蓝球逻辑
        blue_pool = valid_nums[(valid_nums >= 1) & (valid_nums <= 16)]
        blue_pred = (int(blue_pool[-1] + 7) % 16 or 16) if len(blue_pool) > 0 else 16
        
        return red_pred, blue_pred, [int(x[0]) for x in sorted_nodes[:3]]

    def _sync_obsidian(self, record):
        """目标 3：实现人机协同知识沉淀 (同步至 Obsidian)"""
        report_content = f"""# SSQ V66.1 仲裁协同报告
> 关联索引: [[ZhenSuanTianJi V66.0 项目准则]]
> 协同次数: 第 {record['iter']} 次迭代

## 🔮 动能对冲预测结果
- **核心红球**: {' '.join(f'{x:02d}' for x in record['reds'])}
- **核心蓝球**: {record['blue']:02d}

## 🧠 仲裁决策逻辑
1. **高动能节点**: {record['high_energy']}
2. **状态记录**: 物理写入成功，已修复 JSON 初始化异常。

---
生成于: {record['timestamp']}
"""
        with open(LATEST_MD, "w", encoding="utf-8") as f:
            f.write(report_content)

    def run(self):
        try:
            df = pd.read_csv(CSV_FILE, on_bad_lines='skip')
            reds, blue, high_energy = self._calculate_weights(df)
            
            record = {
                "iter": self.memory.get("iterations", 0) + 1,
                "reds": reds,
                "blue": blue,
                "high_energy": high_energy,
                "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            }
            
            # 更新记忆
            self.memory["iterations"] = record["iter"]
            self.memory["history"] = (self.memory.get("history", []) + [record])[-10:]
            with open(MEMORY_FILE, 'w', encoding='utf-8') as f:
                json.dump(self.memory, f, indent=4, ensure_ascii=False)
            
            self._sync_obsidian(record)
            print(f"✅ 协同完成！迭代次数: {record['iter']}")
            print(f"🔮 高动能号: {high_energy}")
        except Exception as e:
            print(f"🔥 系统崩溃: {str(e)}")

if __name__ == "__main__":
    ZhenSuanTianJiArbitrator().run()