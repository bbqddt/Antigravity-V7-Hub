import pandas as pd
from sklearn.ensemble import RandomForestRegressor
import numpy as np
import re
import os

def auto_pilot():
    try:
        csv_p = r'E:\享中\ssq_history_full.csv'
        if not os.path.exists(csv_p):
            print("❌ 核心数据丢失，请检查 CSV 路径。")
            return
        
        df = pd.read_csv(csv_p)
        def parse(row):
            ns = re.findall(r'\d+', " ".join(row.astype(str)))
            return [int(n) for n in ns][-7:]
        
        y = np.array([parse(r) for _, r in df.iterrows() if len(parse(r)) == 7])
        model = RandomForestRegressor(n_estimators=100, random_state=42)
        model.fit(np.arange(len(y)).reshape(-1, 1), y)
        
        res = model.predict([[len(y)]])[0]
        reds = sorted(list(set([max(1, min(33, int(round(x)))) for x in res[:6]])))
        while len(reds) < 6: reds.append((max(reds) % 33) + 1)
        blue = max(1, min(16, int(round(res[6]))))
        
        print("\n" + "★"*30)
        print(f"  👑 震算天机：顾问决策结果 👑")
        print("★"*30)
        print(f"🔮 红球决策：{sorted(reds)}")
        print(f"🔮 蓝球决策：[{blue}]")
        print("★"*30)
    except Exception as e:
        print(f"⚠️ 顾问提示：逻辑执行中断 -> {e}")

if __name__ == "__main__":
    auto_pilot()
