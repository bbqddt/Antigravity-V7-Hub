import requests, os, re
def execute_autonomous_build():
    os.environ['NO_PROXY'] = '127.0.0.1,localhost'
    prompt = "你现在是架构师。请为我编写基于随机森林的 SSQ 预测 Python 代码。只输出代码块。"
    url = "http://127.0.0.1:11434/api/generate"
    payload = {"model": "deepseek-coder:latest", "prompt": prompt, "stream": False}
    print("🛰️ 正在通过本地 11434 端口下达指令...")
    try:
        response = requests.post(url, json=payload, timeout=180, proxies={'http': None, 'https': None})
        if response.status_code == 200:
            full_text = response.json().get('response', '')
            with open('predict_engine_v1.py', 'w', encoding='utf-8') as f:
                f.write(full_text)
            print("✨ 成功！已生成: predict_engine_v1.py")
    except Exception as e: print(f"❌ 错误: {e}")
if __name__ == "__main__": execute_autonomous_build()
