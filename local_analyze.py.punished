import requests
import os

# ==========================================
# 震算天机 - 自主执行引擎 (跳过 IDE UI 限制)
# ==========================================

def execute_autonomous_build():
    os.environ['NO_PROXY'] = '127.0.0.1,localhost'
    
    # 告诉 DS：不要只说话，直接给我代码，我要存成文件
    prompt = """
你现在是“震算天机”系统的架构师。IDE 的 Agent 界面已锁死，你必须通过代码直接协助我。
任务：请基于随机森林算法编写一个完善的预测脚本。
要求：
1. 读取 ssq_history_full.csv。
2. 实现训练与预测逻辑。
3. 代码必须包含完整的注释。
注意：只输出代码块，不要解释，我会直接解析你的输出并保存。
"""

    url = "http://127.0.0.1:11434/api/generate"
    payload = {"model": "deepseek-coder:latest", "prompt": prompt, "stream": False}

    print("🛰️ 正在通过本地链路下达构建指令...")
    
    try:
        response = requests.post(url, json=payload, timeout=120, proxies={'http': None, 'https': None})
        if response.status_code == 200:
            raw_code = response.json().get('response', '')
            
            # 自动化提取并写入文件
            with open('predict_engine_v1.py', 'w', encoding='utf-8') as f:
                f.write(raw_code)
            
            print("✨ 成功！本地 DeepSeek 已自主生成 predict_engine_v1.py。")
            print("📂 你现在可以直接在 IDE 左侧文件树中点击并运行它了。")
        else:
            print(f"❌ 通信失败: {response.status_code}")
    except Exception as e:
        print(f"❌ 错误: {e}")

if __name__ == "__main__":
    execute_autonomous_build()