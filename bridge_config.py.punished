import requests
import os
import time

PREDICTION_FILE = "Latest_Prediction.md"
API_KEY = "AIzaSyBtJNrzX8q2RoDhQzCgUZAffoSRp3SCaus"
MODEL_ID = "gemini-2.5-flash"
URL = f"https://generativelanguage.googleapis.com/v1beta/models/{MODEL_ID}:generateContent?key={API_KEY}"

def run_analysis():
    if not os.path.exists(PREDICTION_FILE):
        print(f"❌ 错误: 找不到 {PREDICTION_FILE}")
        return

    with open(PREDICTION_FILE, "r", encoding="utf-8") as f:
        content = f.read()

    # 只要不成功就一直尝试，间隔逐渐增加
    attempt = 1
    wait_time = 10 
    while True:
        print(f"🚀 [第 {attempt} 次尝试] 正在连接 Gemini (模型: {MODEL_ID})...")
        try:
            response = requests.post(URL, json={"contents": [{"parts": [{"text": content}]}]}, timeout=60)
            
            if response.status_code == 200:
                result = response.json()["candidates"][0]["content"]["parts"][0]["text"]
                with open("analysis_result.md", "w", encoding="utf-8") as f:
                    f.write(result)
                print("✅ 分析成功！结果已写入 analysis_result.md")
                break
            elif response.status_code == 503 or response.status_code == 429:
                print(f"⚠️ 服务器繁忙 (状态码: {response.status_code})，等待 {wait_time} 秒后重试...")
                time.sleep(wait_time)
                wait_time += 10 # 每次失败后多等10秒，避免被封锁
            else:
                print(f"❌ 请求不可恢复 (状态码: {response.status_code})")
                print(f"服务器反馈: {response.text}")
                break
        except Exception as e:
            print(f"❌ 网络波动: {e}")
            time.sleep(wait_time)
            
        attempt += 1

if __name__ == "__main__":
    run_analysis()