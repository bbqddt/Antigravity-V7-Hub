import sys
import json
import requests

# 你的配置信息
API_KEY = "b6063b76fef32c06e2442eca71031ab75ccb423337dc331349db38532be06cb4"
BASE_URL = "http://127.0.0.1:27123" # 确保是你在 Obsidian 设置里看到的 HTTP 端口

def get_vault_files():
    headers = {"Authorization": f"Bearer {API_KEY}"}
    try:
        response = requests.get(f"{BASE_URL}/vault/", headers=headers, timeout=5)
        return response.json()
    except Exception as e:
        return {"error": str(e)}

if __name__ == "__main__":
    # 简单的连接测试
    print(json.dumps(get_vault_files(), indent=2, ensure_ascii=False))